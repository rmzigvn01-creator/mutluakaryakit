# Supabase: Project Settings → Database → Connection string (URI)
# Pooler (Transaction, port 6543) — uygulama
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct (port 5432) — prisma migrate / db push
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"
# Supabase Storage: kalıcı dosya deposu (evrak + iş emri fotoğrafları)
# Project Settings → API → Project URL / service_role key
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET="mutlu-files"
JWT_SECRET="mutlu-akaryakit-dev-secret-change-in-production"
PORT=3001
UPLOAD_DIR="./uploads"
OCR_TOLERANCE_TL=2
OCR_TIME_TOLERANCE_MINUTES=30

# iOS/Android push bildirimleri (Firebase Cloud Messaging)
FCM_SERVER_KEY=
